\ProvidesFile{tulmss-base.fd}[2026-08-29 v1.0a LaTeX font definitions for Latin Modern in base mode]
\DeclareFontFamily{TU}{lmss-base}{}
\DeclareFontShape{TU}{lmss-base}{m}{n}
  {<-8.5> \UnicodeFontFile{lmsans8-regular}{\UnicodeFontTeXLigatures mode=base;}
   <8.5-9.5> \UnicodeFontFile{lmsans9-regular}{\UnicodeFontTeXLigatures mode=base;}
   <9.5-11>  \UnicodeFontFile{lmsans10-regular}{\UnicodeFontTeXLigatures mode=base;}
   <11-15.5> \UnicodeFontFile{lmsans12-regular}{\UnicodeFontTeXLigatures mode=base;}
   <15.5-> \UnicodeFontFile{lmsans17-regular}{\UnicodeFontTeXLigatures mode=base;}
   }{}
\DeclareFontShape{TU}{lmss-base}{m}{it}
   {<->ssub*lmss-base/m/sl}{}
\DeclareFontShape{TU}{lmss-base}{m}{sl}
  {<-8.5> \UnicodeFontFile{lmsans8-oblique}{\UnicodeFontTeXLigatures mode=base;}
   <8.5-9.5> \UnicodeFontFile{lmsans9-oblique}{\UnicodeFontTeXLigatures mode=base;}
   <9.5-11>  \UnicodeFontFile{lmsans10-oblique}{\UnicodeFontTeXLigatures mode=base;}
   <11-15.5> \UnicodeFontFile{lmsans12-oblique}{\UnicodeFontTeXLigatures mode=base;}
   <15.5-> \UnicodeFontFile{lmsans17-oblique}{\UnicodeFontTeXLigatures mode=base;}
   }{}
\DeclareFontShape{TU}{lmss-base}{m}{sc}
  {<->sub*lmr-base/m/sc}{}
\DeclareFontShape{TU}{lmss-base}{b}{n}
  {<->ssub * lmss-base/bx/n}{}
\DeclareFontShape{TU}{lmss-base}{b}{sl}
  {<->ssub * lmss-base/bx/sl}{}
\DeclareFontShape{TU}{lmss-base}{b}{it}
  {<->ssub * lmss-base/bx/it}{}
\DeclareFontShape{TU}{lmss-base}{sbc}{n}
  {<-> \UnicodeFontFile{lmsansdemicond10-regular}{\UnicodeFontTeXLigatures mode=base;}}{}
\DeclareFontShape{TU}{lmss-base}{sbc}{sl}
  {<-> \UnicodeFontFile{lmsansdemicond10-oblique}{\UnicodeFontTeXLigatures mode=base;}}{}
\DeclareFontShape{TU}{lmss-base}{sbc}{it}
  {<->ssub*lmss-base/sbc/sl}{}
\DeclareFontShape{TU}{lmss-base}{bx}{n}
  {<-> \UnicodeFontFile{lmsans10-bold}{\UnicodeFontTeXLigatures mode=base;}}{}
\DeclareFontShape{TU}{lmss-base}{bx}{sl}
  {<-> \UnicodeFontFile{lmsans10-boldoblique}{\UnicodeFontTeXLigatures mode=base;}}{}
\DeclareFontShape{TU}{lmss-base}{bx}{it}
  {<->ssub*lmss-base/bx/sl}{}
